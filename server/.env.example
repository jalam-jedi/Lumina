# OmniTrack Environment Variables – Example
# Copy this file to .env and fill in your real values
# NEVER commit the .env file to git

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_32_character_string_here
TMDB_API_KEY=get_from_themoviedb.org_settings
GOOGLE_BOOKS_API_KEY=optional_get_from_console.cloud.google.com
CLOUDINARY_URL=optional_get_from_cloudinary.com
