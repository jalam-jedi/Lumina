PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT - use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_random_64_char_hex_string

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
FRONTEND_URL=http://localhost:5173

# Phase 5-6 (add these when you reach those phases)
TMDB_API_KEY=get_from_themoviedb.org_settings
GOOGLE_BOOKS_API_KEY=optional_get_from_console.cloud.google.com
CLOUDINARY_URL=optional_get_from_cloudinary.com
