# ============================================
# OmniTrack – Root .gitignore
# ============================================

# Planning / internal docs (not for repo)
_docs/

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Uploaded files (if stored locally)
server/uploads/

# Coverage
coverage/
